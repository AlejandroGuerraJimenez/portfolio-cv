---
import Header from "../components/Header.astro";
import About from "../components/About.astro";
import Timeline from "../components/Timeline.astro";
import Technologies from "../components/Technologies.astro";
import Skills from "../components/Skills.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";
import { person } from "../data/cv";
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content={`${person.name} — ${person.title}. Portfolio and CV for junior software roles in Spain and Europe.`}
    />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.ico`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:ital,wght@0,400;0,500;0,600;1,400&family=Syne:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{person.name} — {person.title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="page" id="top">
      <Header />
      <main id="main">
        <About />
        <Timeline />
        <Technologies />
        <Skills />
        <Contact />
      </main>
      <Footer />
    </div>
  </body>
</html>
