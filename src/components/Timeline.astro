---
import { timeline } from "../data/cv";

const isPlaceholder = (value: string) => value.includes("[PLACEHOLDER:");
---

<section id="story" class="section story" aria-labelledby="story-heading">
  <div class="wrap">
    <header class="story__header">
      <p class="section__label">My story</p>
      <h2 id="story-heading">Path so far</h2>
      <p class="section__intro">
        Education, an internship, and the projects I’ve been building.
      </p>
    </header>

    <ol class="timeline">
      {
        timeline.map((entry) => (
          <li class="timeline__item">
            <p class="timeline__period">
              {isPlaceholder(entry.period) ? (
                <span class="placeholder-tag">{entry.period}</span>
              ) : (
                entry.period
              )}
            </p>
            <div class="timeline__marker" aria-hidden="true" />
            <div class="timeline__body">
              <h3 class="timeline__title">
                {isPlaceholder(entry.title) ? (
                  <span class="placeholder-tag">{entry.title}</span>
                ) : (
                  entry.title
                )}
              </h3>
              <p class="timeline__org">
                {isPlaceholder(entry.org) ? (
                  <span class="placeholder-tag">{entry.org}</span>
                ) : (
                  entry.org
                )}
              </p>
              <p class="timeline__desc">
                {isPlaceholder(entry.description) ? (
                  <span class="placeholder">{entry.description}</span>
                ) : (
                  entry.description
                )}
              </p>
              {entry.tech && entry.tech.length > 0 && (
                <ul class="timeline__tech" aria-label="Technologies used">
                  {entry.tech.map((t) => (
                    <li class={isPlaceholder(t) ? "is-placeholder" : undefined}>{t}</li>
                  ))}
                </ul>
              )}
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .timeline {
    position: relative;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .timeline__item {
    position: relative;
    display: grid;
    gap: 0.35rem 0;
    padding-left: 1.75rem;
    padding-bottom: var(--space-xl);
  }

  .timeline__item:last-child {
    padding-bottom: 0;
  }

  .timeline__item::before {
    content: "";
    position: absolute;
    left: 0.35rem;
    top: 0.55rem;
    bottom: -0.55rem;
    width: 1px;
    background: var(--line-strong);
  }

  .timeline__item:last-child::before {
    display: none;
  }

  .timeline__marker {
    position: absolute;
    left: 0.1rem;
    top: 0.45rem;
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--paper) 70%, white);
  }

  .timeline__period {
    margin: 0;
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--ink-muted);
    max-width: none;
  }

  .timeline__title {
    margin-bottom: 0.25rem;
    line-height: 1.35;
    overflow: visible;
  }

  .timeline__org {
    margin: 0 0 var(--space-sm);
    font-size: 0.98rem;
    font-weight: 500;
    color: var(--accent);
    max-width: none;
  }

  .timeline__desc {
    margin-bottom: var(--space-sm);
  }

  .timeline__tech {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.55rem;
  }

  .timeline__tech li {
    font-size: 0.82rem;
    color: var(--ink-soft);
    padding-bottom: 0.05rem;
    border-bottom: 1px solid var(--line);
  }

  .timeline__tech li.is-placeholder {
    color: var(--ink-muted);
    font-style: italic;
    border-bottom-style: dashed;
  }

  @media (min-width: 720px) {
    .timeline__item {
      grid-template-columns: 10.5rem 1.1rem minmax(0, 1fr);
      column-gap: 1.35rem;
      padding-left: 0;
      align-items: start;
    }

    .timeline__item::before {
      left: calc(10.5rem + 0.5rem);
      top: 0.55rem;
    }

    .timeline__marker {
      position: static;
      margin-top: 0.45rem;
      justify-self: center;
      box-shadow: 0 0 0 3px var(--paper-deep);
    }

    .timeline__period {
      text-align: right;
      padding-top: 0.15rem;
    }
  }
</style>
