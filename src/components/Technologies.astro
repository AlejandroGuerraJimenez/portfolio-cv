---
import { technologies } from "../data/cv";

const isPlaceholder = (value: string) => value.includes("[PLACEHOLDER:");
---

<section
  id="technologies"
  class="section technologies"
  aria-labelledby="tech-heading"
>
  <div class="wrap">
    <header>
      <p class="section__label">Technologies</p>
      <h2 id="tech-heading">Tools I work with</h2>
      <p class="section__intro">
        Programming languages, frameworks, and tools from projects, coursework, and the internship.
      </p>
    </header>

    <div class="tech-grid">
      {
        technologies.map((category) => (
          <div class="tech-group">
            <h3 class="tech-group__label">{category.label}</h3>
            <ul class="tech-group__list">
              {category.items.map((item) => (
                <li class={isPlaceholder(item) ? "is-placeholder" : undefined}>{item}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .tech-grid {
    display: grid;
    gap: var(--space-xl) var(--space-lg);
  }

  @media (min-width: 640px) {
    .tech-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 960px) {
    .tech-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .tech-group__label {
    display: flex;
    flex-direction: column;
    gap: 0.85em;
    width: 100%;
    margin: 0 0 var(--space-md);
    padding: 0;
    border: none;
    font-size: 0.95rem;
    line-height: 1.4;
    letter-spacing: 0.02em;
    overflow: visible;
  }

  .tech-group__label::after {
    content: "";
    display: block;
    width: 100%;
    height: 1px;
    background: var(--line);
    flex-shrink: 0;
  }

  .tech-group__list {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .tech-group__list li {
    font-size: 0.98rem;
    color: var(--ink-soft);
    padding-left: 0.85rem;
    position: relative;
  }

  .tech-group__list li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.65em;
    width: 0.35rem;
    height: 1px;
    background: var(--accent);
  }

  .tech-group__list li.is-placeholder {
    color: var(--ink-muted);
    font-style: italic;
    font-size: 0.9rem;
  }
</style>
